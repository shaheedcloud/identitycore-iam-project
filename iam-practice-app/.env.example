# IdentityCore IAM Practice App - example configuration only
# Copy values manually into your local shell if needed. Do not commit real .env files.

PORT=3000
SESSION_SECRET=replace-with-local-training-secret

# Phase 3A OIDC readiness placeholders only.
# Keep OIDC_ENABLED=false until real values are configured locally in an uncommitted .env file.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Example Identity Provider
OIDC_ISSUER_URL=https://idp.example.local/identitycore
OIDC_CLIENT_ID=replace-with-local-client-id
OIDC_CLIENT_SECRET=replace-with-local-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
OIDC_SCOPES=openid profile email
