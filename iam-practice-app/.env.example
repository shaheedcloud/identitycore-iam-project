# IdentityCore IAM Practice App - example configuration only
# Copy values manually into your local shell if needed. Do not commit real .env files.

PORT=3000
SESSION_SECRET=replace-with-local-training-secret

# Phase 3B Entra OIDC local login placeholders only.
# Keep OIDC_ENABLED=false until real values are configured locally in an uncommitted .env file.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Microsoft Entra ID
OIDC_ISSUER_URL=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
OIDC_CLIENT_ID=replace-with-entra-app-client-id
OIDC_CLIENT_SECRET=replace-with-entra-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
OIDC_SCOPES=openid profile email

# Phase 4 protected API JWT validation placeholders only.
# Keep JWT_VALIDATION_ENABLED=false until real values are configured locally in an uncommitted .env file.
JWT_VALIDATION_ENABLED=false
JWT_ISSUER_URL=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
JWT_AUDIENCE=api://replace-with-api-client-id
JWT_JWKS_URI=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/discovery/v2.0/keys
JWT_CLOCK_TOLERANCE_SECONDS=60

# Phase 5/6 SCIM Users and Groups endpoint simulation placeholders only.
# Keep SCIM_ENABLED=false until a local bearer token is configured in an uncommitted .env file.
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=replace-with-local-scim-bearer-token
SCIM_BASE_URL=http://localhost:3000/scim/v2

# Phase 8 SAML readiness and local simulation placeholders only.
# Keep SAML_ENABLED=false until real values are configured locally in an uncommitted .env file.
SAML_ENABLED=false
SAML_LOCAL_SIMULATION_ENABLED=false
SAML_PROVIDER_NAME=Example SAML Identity Provider
SAML_IDP_SSO_URL=https://idp.example.local/saml/sso
SAML_IDP_ENTITY_ID=https://idp.example.local/saml/entity
SAML_SP_ENTITY_ID=http://localhost:3000/saml/metadata
SAML_ACS_URL=http://localhost:3000/auth/saml/callback
SAML_IDP_CERTIFICATE=replace-with-local-saml-idp-certificate
